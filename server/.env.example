# 本地运行：后台只监听 127.0.0.1，token 留空即可
API_TOKEN=
API_HOST=127.0.0.1
API_PORT=8787
ARXIV_CATEGORIES=cs.CV,cs.LG,cs.CL,cs.AI,cs.MM,cs.SD,eess.AS,eess.IV

# LLM 全部走 ChatGPT.app 自带的 Codex CLI（用 ~/.codex/auth.json 的登录态）
CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
CODEX_MODEL=gpt-5.6-sol
SUMMARY_EFFORT=low        # 速览用低推理，每次 SUMMARY_BATCH 篇打包一次调用
INTERPRET_EFFORT=xhigh    # 深度解读用最高推理
SUMMARY_BATCH=15
SUMMARY_LIMIT=600         # 每次更新最多给最新的多少篇生成速览
PRE_INTERPRET=0           # 默认只做速览；精读在 app 里点开后手动生成。想早上自动精读推荐位前 N 篇就改成 N

# 研究背景与关注词条在 app 的设置里填（存数据库）；下面两项只是首次启动的默认值
RESEARCH_CONTEXT=AI 研究
DEFAULT_TOPICS=
SEARCH_FILTER_EFFORT=low   # Codex 相关性精筛的推理强度
# 引用数来自 Semantic Scholar，不填 key 也能用（共享限速）；有 key 更稳
S2_API_KEY=
